# Optional: override the frontend API target.
# VITE_API_BASE=http://localhost:5174

# Production post-session reflection provider. OPENAI_BASE_URL is optional.
# OpenAI calls default through a local HTTP CONNECT proxy at 127.0.0.1:7897
# (Clash/V2Ray-style), matching the LLM spike. Keep that proxy running for
# live reflection generation.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Reflection comparison-arm credentials. ZAI_API_KEY enables the GLM-5.2 arm;
# DASHSCOPE_API_KEY enables Qwen3.8-Max (Singapore MaaS OpenAI-compatible
# endpoint; DASHSCOPE_BASE_URL is optional); OPENROUTER_API_KEY enables the
# Gemini 3.6 Flash, DeepSeek V4 Pro, and Claude Sonnet 5 arms.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=
# OPENROUTER_API_KEY=
