# Optional: override the frontend API target.
# VITE_API_BASE=http://localhost:5174
# Production defaults to the serving origin; leave VITE_API_BASE unset there.

# Local Clerk fixture mode is isolated from normal trusted-local dogfood.
# APP_AUTH_MODE=clerk
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_AUTHORIZED_PARTY=http://localhost:4175
# VITE_AUTH_MODE=clerk
# VITE_CLERK_PUBLISHABLE_KEY=

# Study-mode backend identity for the default trusted-local dogfood mode.
# APP_LEARNER_ID=dogfood-local

# Production post-session reflection provider. OPENAI_BASE_URL is optional.
# Provider calls use direct outbound connections by default. Local dogfood can
# explicitly route OpenAI and OpenRouter through the Clash/V2Ray-style HTTP
# CONNECT proxy at 127.0.0.1:7897.
# APP_USE_LOCAL_PROVIDER_PROXY=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Reflection comparison-arm credentials. ZAI_API_KEY enables the GLM-5.3 arm;
# OPENROUTER_API_KEY enables the Gemini 3.6 Flash and Claude Sonnet 5 arms.
# GPT-5.6 Terra uses OPENAI_API_KEY with the Luna arm.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=

# Hosted-only backup credentials are injected as platform secrets. Bucket and
# region are non-secret Fly configuration; never commit any real values here.
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_BUCKET=
# LITESTREAM_REGION=ap-southeast-1

# Hosted app-only upgrade smoke identity (Fly env / generated config, not git).
# Prefer the Clerk user_ id. The email is only a resolver. Never put a password here.
# APP_SMOKE_CLERK_USER_ID=user_...
# APP_SMOKE_CLERK_EMAIL=
