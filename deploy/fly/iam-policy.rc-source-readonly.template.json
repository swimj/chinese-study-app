{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBetaBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BETA_BACKUP_BUCKET"
    },
    {
      "Sid": "ReadBetaReplicaListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BETA_BACKUP_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["chinese-study-app/hosted-beta", "chinese-study-app/hosted-beta/*"]
        }
      }
    },
    {
      "Sid": "ReadBetaReplicaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BETA_BACKUP_BUCKET/chinese-study-app/hosted-beta/*"
    }
  ]
}
