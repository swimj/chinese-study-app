{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RcBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::REPLACE_WITH_RC_BACKUP_BUCKET"
    },
    {
      "Sid": "RcBucketListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_RC_BACKUP_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["chinese-study-app/hosted-rc/*"]
        }
      }
    },
    {
      "Sid": "RcReplicaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_RC_BACKUP_BUCKET/chinese-study-app/hosted-rc/*"
    }
  ]
}
