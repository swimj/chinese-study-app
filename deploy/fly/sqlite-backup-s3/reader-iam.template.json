{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSourceBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": "sqlite-backups/REPLACE_WITH_SOURCE_APP/*"
        }
      }
    },
    {
      "Sid": "ReadSourceBackup",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/sqlite-backups/REPLACE_WITH_SOURCE_APP/*"
    }
  ]
}
