{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteNewBackup",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/sqlite-backups/REPLACE_WITH_SOURCE_APP/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "false"
        },
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "VerifyExistingBackup",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/sqlite-backups/REPLACE_WITH_SOURCE_APP/*"
    }
  ]
}
