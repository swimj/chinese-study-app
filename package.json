{
  "name": "chinese-study-app",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node --import tsx server/index.ts --mode=dev --seed-data=server/seeds/mandarin-dev.json",
    "dev:french:frontend": "VITE_STUDY_PROFILE=french vite",
    "dev:french:backend": "node --import tsx server/index.ts --mode=dev --study-profile=french --data-dir=data/french-dev --seed-data=server/seeds/french-dev.json",
    "setup:local-user-data": "node --import tsx scripts/setup-local-user-data.ts",
    "study:local:backend": "node --import tsx server/index.ts --mode=study --study-profile=french --data-dir=data/local-user-data",
    "study:local:frontend": "VITE_STUDY_PROFILE=french vite",
    "study:backend": "node --import tsx server/index.ts --mode=study",
    "reset:dev-data": "node --import tsx server/reset-dev-db.ts --seed-data=server/seeds/mandarin-dev.json",
    "build:canonical-wordlist": "node --import tsx scripts/build-canonical-wordlist.ts",
    "check:study-scheduler-state": "node --import tsx scripts/check-study-scheduler-state.ts",
    "report:word": "node --import tsx scripts/report-word.ts",
    "spike:llm": "node --import tsx spikes/llm-provider/runner/cli.ts",
    "spike:llm:env": "node --env-file=.env --import tsx spikes/llm-provider/runner/cli.ts",
    "spike:llm:view": "node --import tsx spikes/llm-provider/viewer/server.ts",
    "spike:platform": "node --import tsx spikes/hosted-beta-platform/src/server.ts",
    "spike:platform:account": "node --import tsx spikes/hosted-beta-platform/scripts/set-account-enabled.ts",
    "spike:platform:clerk": "node --import tsx spikes/hosted-beta-platform/scripts/clerk-admin.ts",
    "spike:platform:maintenance": "node --import tsx spikes/hosted-beta-platform/scripts/set-maintenance.ts",
    "spike:platform:migrate": "node --import tsx spikes/hosted-beta-platform/scripts/migrate.ts",
    "spike:platform:restore-check": "node --import tsx spikes/hosted-beta-platform/scripts/verify-restore.ts",
    "spike:platform:sentinel": "node --import tsx spikes/hosted-beta-platform/scripts/seed-sentinel.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/express": "^2.1.60",
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.19",
    "@types/node": "^20.13.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
