{
  "name": "chinese-study-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node --import tsx server/index.ts --mode=dev",
    "study:backend": "node --import tsx server/index.ts --mode=study",
    "reset:dev-data": "node --import tsx server/reset-dev-db.ts",
    "export:hack-chinese": "node --import tsx scripts/export-hack-chinese-migration.ts",
    "build:canonical-corpus": "node --import tsx scripts/build-canonical-wordlist.ts",
    "build:canonical-wordlist": "node --import tsx scripts/build-canonical-wordlist.ts",
    "build:study-import": "node --import tsx scripts/build-study-import-artifact.ts",
  "import:canonical-study-db": "node --import tsx scripts/import-canonical-study-db.ts",
  "patch:hack-chinese-review": "node --import tsx scripts/patch-hack-chinese-review-progress.ts",
  "import:hack-chinese-curated-unmatched": "node --import tsx scripts/import-curated-hack-chinese-unmatched.ts",
  "report:canonical-overlap": "node --import tsx scripts/report-canonical-overlap.ts",
    "fixture:hack-chinese-review": "node --import tsx scripts/load-hack-chinese-review-fixture.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.19",
    "@types/node": "^20.13.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
