{
  "name": "chinese-study-app",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node --import tsx server/index.ts --mode=dev --seed-data=server/seeds/mandarin-dev.json",
    "dev:clerk:backend": "APP_AUTH_MODE=clerk PORT=5176 APP_DATA_DIR=data/clerk-dev node --import tsx server/index.ts --mode=dev --seed-data=server/seeds/mandarin-dev.json",
    "dev:clerk:frontend": "VITE_AUTH_MODE=clerk VITE_API_BASE=http://localhost:5176 vite --port 4175",
    "db:migrate": "node --import tsx scripts/migrate-database.ts",
    "study:backend": "node --import tsx server/index.ts --mode=study",
    "start:hosted": "node --import tsx server/index.ts --mode=study --auth-mode=clerk",
    "bootstrap:hosted:mandarin": "node --import tsx scripts/bootstrap-hosted-mandarin.ts",
    "hosted:control": "node --import tsx scripts/set-hosted-service-control.ts",
    "hosted:banner": "node --import tsx scripts/set-hosted-service-banner.ts",
    "hosted:learner-control": "node --import tsx scripts/set-hosted-learner-disabled.ts",
    "hosted:maintain-pure-cues": "node --import tsx scripts/maintain-pure-cues.ts",
    "hosted:prepare-dogfood": "node --import tsx scripts/prepare-hosted-dogfood-cutover.ts",
    "hosted:promote-dogfood": "node --import tsx scripts/promote-hosted-dogfood-cutover.ts",
    "hosted:sentinel": "node --import tsx scripts/seed-deployment-sentinel.ts",
    "hosted:invite": "node --import tsx scripts/invite-hosted-learner.ts",
    "hosted:inspect": "node --import tsx scripts/inspect-hosted-service.ts",
    "content:bulk-repertoire": "node --import tsx scripts/bulk-repertoire.ts",
    "hosted:backfill-luna-costs": "node --import tsx scripts/backfill-luna-invocation-costs.ts",
    "hosted:inspect-client-incidents": "node --import tsx scripts/inspect-client-incident-diagnostics.ts",
    "hosted:inspect-request-timings": "node --import tsx scripts/inspect-request-timings.ts",
    "hosted:smoke": "node --import tsx scripts/smoke-hosted-service.ts",
    "hosted:rc": "node --import tsx scripts/manage-hosted-rc.ts",
    "hosted:rehearse": "node --import tsx scripts/manage-hosted-rehearsal.ts",
    "hosted:rc:promote-db": "node --import tsx scripts/promote-hosted-rc-database.ts",
    "hosted:rc:verify-source": "node --import tsx scripts/verify-hosted-rc-source.ts",
    "hosted:upgrade": "node --import tsx scripts/upgrade-hosted-service.ts",
    "hosted:track": "node --import tsx scripts/release-tracker.ts",
    "hosted:build": "node --import tsx scripts/build-hosted-image.ts",
    "hosted:verify-restore": "node --import tsx scripts/verify-hosted-restore.ts",
    "reset:dev-data": "node --import tsx server/reset-dev-db.ts --seed-data=server/seeds/mandarin-dev.json",
    "build:canonical-wordlist": "node --import tsx scripts/build-canonical-wordlist.ts",
    "build:deck-manifest": "node --import tsx scripts/build-deck-manifest.ts",
    "report:word": "node --import tsx scripts/report-word.ts",
    "inspect:word-content": "node --import tsx scripts/inspect-word-content.ts",
    "backfill:dogfood-shared-trial": "node --import tsx scripts/backfill-dogfood-shared-trial.ts",
    "spike:llm": "node --import tsx spikes/llm-provider/runner/cli.ts",
    "spike:llm:env": "node --env-file=.env --import tsx spikes/llm-provider/runner/cli.ts",
    "spike:llm:view": "node --import tsx spikes/llm-provider/viewer/server.ts",
    "spike:platform": "node --import tsx spikes/hosted-beta-platform/src/server.ts",
    "spike:platform:account": "node --import tsx spikes/hosted-beta-platform/scripts/set-account-enabled.ts",
    "spike:platform:clerk": "node --import tsx spikes/hosted-beta-platform/scripts/clerk-admin.ts",
    "spike:platform:maintenance": "node --import tsx spikes/hosted-beta-platform/scripts/set-maintenance.ts",
    "spike:platform:migrate": "node --import tsx spikes/hosted-beta-platform/scripts/migrate.ts",
    "spike:platform:restore-check": "node --import tsx spikes/hosted-beta-platform/scripts/verify-restore.ts",
    "spike:platform:sentinel": "node --import tsx spikes/hosted-beta-platform/scripts/seed-sentinel.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "dev:intro-lab": "node --env-file-if-exists=.env --import tsx scripts/dev-introduction-lab.ts",
    "hosted:whats-new": "node --import tsx scripts/manage-whats-new.ts",
    "dev:new-learner": "node --env-file-if-exists=.env --import tsx scripts/dev-new-learner.ts",
    "hosted:observe": "node --import tsx scripts/observe-hosted-service.ts",
    "testbed": "node --import tsx scripts/testbed.ts",
    "hosted:backup": "node --import tsx scripts/manage-hosted-backup.ts",
    "hosted:backup-service": "node --import tsx scripts/run-backup-service.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@clerk/express": "^2.1.60",
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "openai": "^7.57.0",
    "opencc-js": "1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.19",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
