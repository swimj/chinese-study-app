{
  "name": "chinese-study-app",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node --import tsx server/index.ts --mode=dev --seed-data=server/seeds/mandarin-dev.json",
    "dev:reflection:backend": "node --import tsx server/index.ts --mode=dev --include-dev-contrast-seed=false --seed-data=server/seeds/reflection-dev.json",
    "dev:french:frontend": "VITE_STUDY_PROFILE=french vite",
    "dev:french:backend": "node --import tsx server/index.ts --mode=dev --study-profile=french --data-dir=data/french-dev --seed-data=server/seeds/french-dev.json",
    "friend:mandarin:setup-db": "node --import tsx scripts/build-friend-mandarin-db.ts --force",
    "friend:mandarin:bundle": "node --import tsx scripts/build-friend-mandarin-bundle.ts",
    "friend:mandarin:backend": "node --import tsx server/index.ts --mode=study --study-profile=mandarin --data-dir=data/friend-mandarin-user-data",
    "friend:mandarin:frontend": "vite",
    "setup:local-user-data": "node --import tsx scripts/setup-local-user-data.ts",
    "import:local-user-data": "node --import tsx scripts/import-local-user-data-from-instance.ts",
    "study:local:backend": "node --import tsx server/index.ts --mode=study --study-profile=french --data-dir=data/local-user-data",
    "study:local:frontend": "VITE_STUDY_PROFILE=french vite",
    "study:backend": "node --import tsx server/index.ts --mode=study",
    "reset:dev-data": "node --import tsx server/reset-dev-db.ts --seed-data=server/seeds/mandarin-dev.json",
    "reset:reflection-verification": "node --import tsx scripts/reset-reflection-verification-db.ts",
    "seed:reflection-review-fixture": "node --import tsx scripts/seed-reflection-review-fixture.ts",
    "export:hack-chinese": "node --import tsx scripts/export-hack-chinese-migration.ts",
    "build:canonical-wordlist": "node --import tsx scripts/build-canonical-wordlist.ts",
    "build:study-import": "node --import tsx scripts/build-study-import-artifact.ts",
    "backfill:word-meanings": "node --import tsx scripts/backfill-word-meanings.ts",
    "report:canonical-overlap": "node --import tsx scripts/report-canonical-overlap.ts",
    "list:contrast-content": "node --import tsx scripts/list-contrast-content.ts",
    "check:study-management-state": "node --import tsx scripts/check-study-management-state.ts",
    "check:study-scheduler-state": "node --import tsx scripts/check-study-scheduler-state.ts",
    "report:word": "node --import tsx scripts/report-word.ts",
    "report:reflection-state": "node --import tsx scripts/report-reflection-state.ts",
    "retire:review-items": "node --import tsx scripts/retire-review-items.ts",
    "spike:llm": "node --import tsx spikes/llm-provider/runner/cli.ts",
    "spike:llm:env": "node --env-file=.env --import tsx spikes/llm-provider/runner/cli.ts",
    "spike:llm:view": "node --import tsx spikes/llm-provider/viewer/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.19",
    "@types/node": "^20.13.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
