{
  "name": "mandarin-journal-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "start:live": "JOURNAL_PROFILE=live node --env-file-if-exists=../../.env --env-file-if-exists=.env server.ts",
    "start:copy": "JOURNAL_PROFILE=copy node --env-file-if-exists=../../.env --env-file-if-exists=.env server.ts",
    "journal:lookups": "node journal-cli.ts lookups",
    "journal:where": "node journal-cli.ts where",
    "journal:backup": "node journal-cli.ts backup",
    "journal:copy-live": "node journal-cli.ts copy-live",
    "journal:fixture": "node journal-cli.ts fixture",
    "journal:media-report": "node media-report.ts",
    "check": "tsc --noEmit",
    "test": "node --test *.test.ts *.test.mjs lookup-experiment/*.test.ts",
    "lookup:eval": "node lookup-experiment/run.ts"
  },
  "dependencies": {
    "@openai/agents": "0.22.0",
    "ipaddr.js": "^2.5.0",
    "parse5": "^8.1.1",
    "pdfjs-dist": "6.5.438",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
