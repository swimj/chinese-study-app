{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "src/vite-env.d.ts",
    "src/opencc-dictionaries.d.ts"
  ],
  "exclude": ["tests/fixtures/**"]
}
